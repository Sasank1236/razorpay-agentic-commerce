# Environment variables for LOCAL development only
# ⚠️  DO NOT commit the real .env file — only .env.example goes to GitHub

# Database — SQLite for local, PostgreSQL on Render (injected automatically)
DATABASE_URL=sqlite:///./razorbuy.db

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# OpenAI (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Razorpay Test Mode — get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# CORS — comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
